import os
import time
import requests
from selenium import webdriver
from selenium.webdriver.chrome.options import Options

url = "https://dermnetnz.org/images/alopecia-areata-images"
output_dir = "datasets/alopecia_areata"  # Save images in the correct folder
os.makedirs(output_dir, exist_ok=True)

# Set up Selenium (headless mode)
chrome_options = Options()
chrome_options.add_argument("--headless")
driver = webdriver.Chrome(options=chrome_options)

driver.get(url)
time.sleep(5)  # Wait for JS to load images

# Get image elements
images = driver.find_elements("tag name", "img")
img_urls = [img.get_attribute("src") for img in images if img.get_attribute("src")]

for idx, img_url in enumerate(img_urls):
    if img_url.startswith("http"):
        try:
            img_data = requests.get(img_url).content
            ext = img_url.split('.')[-1].split('?')[0]
            filename = f"alopecia_areata_{idx}.{ext}"
            with open(os.path.join(output_dir, filename), "wb") as f:
                f.write(img_data)
            print(f"Downloaded {filename}")
        except Exception as e:
            print(f"Failed to download {img_url}: {e}")

driver.quit()
print("Download complete.")
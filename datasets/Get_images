import os
import time
import requests
from selenium import webdriver
from selenium.webdriver.chrome.options import Options

url = "https://dermnetnz.org/images?query=Trichotillomania"
output_dir = "datasets/hair_only/scalp_diseases/trichotillomania"  # Save images in this folder
os.makedirs(output_dir, exist_ok=True)

# Set up Selenium (headless)
chrome_options = Options()
chrome_options.add_argument("--headless")
chrome_options.add_argument("--disable-gpu")
chrome_options.add_argument("--no-sandbox")
chrome_options.add_argument("--disable-dev-shm-usage")
chrome_options.add_argument("--window-size=1920,1080")

driver = webdriver.Chrome(options=chrome_options)

driver.get(url)
time.sleep(3)  # initial load

# Scroll a few times to allow images to load
for _ in range(6):
    driver.execute_script("window.scrollTo(0, document.body.scrollHeight);")
    time.sleep(2)

# Collect image URLs
images = driver.find_elements("tag name", "img")
img_urls = []
for img in images:
    src = img.get_attribute("src")
    if src and src.startswith("http"):
        img_urls.append(src)

# Download images
for idx, img_url in enumerate(sorted(set(img_urls))):
    try:
        img_data = requests.get(img_url, timeout=10).content
        ext = img_url.split('.')[-1].split('?')[0]
        if len(ext) > 5 or ext.lower() not in ["jpg", "jpeg", "png", "gif", "webp"]:
            ext = "jpg"
        filename = f"trichotillomania_{idx}.{ext}"
        with open(os.path.join(output_dir, filename), "wb") as f:
            f.write(img_data)
        print(f"Downloaded {filename}")
    except Exception as e:
        print(f"Failed to download {img_url}: {e}")

driver.quit()
print("Download complete.")
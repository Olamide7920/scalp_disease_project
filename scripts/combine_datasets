import os
import shutil

src = "datasets/hair_only/scalp_disease/alopecia-areata"
dst = "datasets/hair_only/scalp_diseases/alopecia-areata"
os.makedirs(dst, exist_ok=True)

for img_file in os.listdir(src):
    if img_file.lower().endswith(('.jpg', '.jpeg', '.png')):
        src_path = os.path.join(src, img_file)
        dst_path = os.path.join(dst, img_file)
        shutil.move(src_path, dst_path)
        print(f"Moved {img_file} from {src} to {dst}")